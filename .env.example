# AWS S3 configuration
S3_BUCKET=your-bucket-name
BUCKET_NAME_RAW=your-raw-bucket-name
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key

# Google Sheets configuration
GOOGLE_SHEETS_CREDENTIALS=path-to-credentials.json
SHEET_ID_KEYWORDS=your-keywords-sheet-id
SHEET_ID_INVESTORS=your-investors-sheet-id

# LLM service
LLM_SERVICE=OpenAI-or-Azure

# OpenAI configuration
OPENAI_API_KEY=your-openai-api-key

# Azure OpenAI configuration
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=your-azure-endpoint
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# User configuration
USER_EMAIL=your-email@example.com

# Langfuse configuration
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=your-langfuse-host

# Slack configuration
SLACK_WEBHOOK_URL_TESTING=your-slack-webhook-url-testing
SLACK_WEBHOOK_URL_DISCOVERY=your-slack-webhook-url-discovery
